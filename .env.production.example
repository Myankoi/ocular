APP_NAME=Ocular
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://ocular.example.com
APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

LOG_CHANNEL=stderr
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=db
DB_PORT=3306
DB_DATABASE=ocular
DB_USERNAME=ocular
DB_PASSWORD=change-this-database-password
DB_ROOT_PASSWORD=change-this-root-password

# MySQL image initialization (keep these aligned with DB_* above).
MYSQL_DATABASE=ocular
MYSQL_USER=ocular
MYSQL_PASSWORD=change-this-database-password
MYSQL_ROOT_PASSWORD=change-this-root-password

SESSION_DRIVER=database
SESSION_LIFETIME=120
QUEUE_CONNECTION=sync
CACHE_STORE=database
FILESYSTEM_DISK=local

MAIL_MAILER=log
MAIL_FROM_ADDRESS=hello@example.com
MAIL_FROM_NAME="${APP_NAME}"

WEB_BIND_ADDRESS=127.0.0.1
WEB_PORT=8080
